# Optional public website URL. Leave blank during local setup.
NUXT_PUBLIC_SITE_URL=

# Empty uses same-origin API routes, including the Craft proxy in development.
# Set an absolute backend origin for an external API or fetching during generation.
NUXT_PUBLIC_API_BASE=

# Optional GA4 web-stream measurement ID (public, not a secret).
# Requires the production SITE_URL above; rebuild generated files after changing.
# Analytics loads only after the visitor accepts it, and stays off in local dev.
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Nuxt's dev server defaults to http://localhost:3000.
# NUXT_HOST=127.0.0.1
# NUXT_PORT=3000

# Server-only Craft origin for HTML generation/SSR outside DDEV (no secrets).
# NUXT_CRAFT_API_ORIGIN=https://your-craft-site.example
